#!/usr/bin/env bash
#
# snapstart — run a Farcaster read node and a client that talks to it.
#
#   ./snapstart provision    (0) furnish the compute
#   ./snapstart node up      (1) start a Snapchain read node
#   ./snapstart client create(2) issue an app key and launch the client
#
#   ./snapstart status       what exists right now, and what it costs
#   ./snapstart tunnel       forward the node's API to localhost:3381
#   ./snapstart ssh          shell into the node
#   ./snapstart destroy      delete everything this created
#
# Defaults to AWS. Hetzner is ~a third the price but its new-account volume cap
# is too small to complete a restore: SNAPSTART_PROVIDER=hetzner once raised.
#
# The only credential any of this needs is a cloud API key, used solely to create
# the server. The node itself runs with no API keys from anyone.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"
STATE_DIR=".state"
SSH_KEY="$STATE_DIR/id_snapstart"
API="https://api.hetzner.cloud/v1"

# Resource names. Reused on re-runs, which is what makes this idempotent:
# provisioning twice finds the instance tagged with this name and adopts it
# rather than creating a second one.
#
# Override it to run a second, independent node — a staging box, or a from-zero
# rehearsal while your real node keeps serving. It namespaces the instance tag,
# the security group AND the key pair; sharing the key pair across two checkouts
# would hand the new instance the old checkout's public key, leaving a box you
# cannot ssh into.
NAME="${SNAPSTART_NAME:-snapstart-node}"

# AWS is the default because it is the only provider we have verified can
# actually complete a restore on a brand-new account.
#
# Restoring is a three-stage pipeline per shard — download gzipped chunks,
# concatenate them into one tar, unpack that tar into RocksDB — and upstream
# deletes the staging directory only after ALL shards finish
# (src/storage/db/snapshot.rs). So every shard's chunks and tar sit on disk for
# the whole restore. Measured peak: ~1,580 GB, against a final database near
# 550 GB.
#
# Hetzner Cloud caps new accounts at 1024 GB of volume storage (verified: a
# resize to 1030 GB returns resource_limit_exceeded), which is not enough.
# Hetzner remains supported and is roughly a third the price — but only if your
# account's quota has been raised. See README.
PROVIDER="${SNAPSTART_PROVIDER:-aws}"

# State is per-provider. A single node.json meant provisioning on AWS silently
# clobbered the record of a running Hetzner node — leaving a billing server with
# no local trace of how to reach or destroy it.
# Named nodes get their own state file too, so a second node in the same
# checkout cannot overwrite the record of the first.
if [ "$NAME" = "snapstart-node" ]; then
  STATE_FILE="$STATE_DIR/node-$PROVIDER.json"
else
  STATE_FILE="$STATE_DIR/node-$PROVIDER-$NAME.json"
fi

# A legacy node.json is honoured only when it actually belongs to this provider.
# Matching on filename alone reintroduced the clobber: with PROVIDER=aws and a
# Hetzner-era node.json present, provisioning would write AWS state over it.
if [ ! -f "$STATE_FILE" ] && [ -f "$STATE_DIR/node.json" ]; then
  if [ "$(jq -r '.provider // "hetzner"' "$STATE_DIR/node.json" 2>/dev/null)" = "$PROVIDER" ]; then
    STATE_FILE="$STATE_DIR/node.json"
  fi
fi

# Record infrastructure the moment it exists, never after. Anything between
# creating a resource and persisting its id is a window where a failure leaves
# something billing with no local record of it — which has already happened
# twice here. Written via a temp file so an interrupt cannot truncate it.
write_state() {
  mkdir -p "$STATE_DIR"
  cat > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

# Merge fields into existing state, e.g. an IP that only appears after boot.
update_state() {
  [ -f "$STATE_FILE" ] || die "no state to update"
  jq "$@" "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

# --- AWS -------------------------------------------------------------------
#   m5.xlarge   4 vCPU / 16 GB — the instance the Snapchain docs specify
#   2048 GB     root volume. AWS lets the root disk be any size, so unlike
#               Hetzner there is no second volume to attach, format or mount.
AWS_INSTANCE_TYPE="${SNAPSTART_AWS_INSTANCE_TYPE:-m5.xlarge}"
AWS_REGION="${SNAPSTART_AWS_REGION:-us-east-1}"
AWS_DISK_GB="${SNAPSTART_DISK_GB:-2048}"

# --- Hetzner ---------------------------------------------------------------
#   cx43     8 vCPU / 16 GB — exceeds snapchain's documented 4 vCPU / 16 GB
#   fsn1     Falkenstein; a syncing node does not care about your latency
SERVER_TYPE="${SNAPSTART_SERVER_TYPE:-cx43}"
LOCATION="${SNAPSTART_LOCATION:-fsn1}"
VOLUME_GB="${SNAPSTART_VOLUME_GB:-1024}"
IMAGE="ubuntu-24.04"

# Installed by cloud-init on first boot. Four lines of YAML is the whole
# difference between a bare Ubuntu box and one that can run snapchain.
CLOUD_INIT='#cloud-config
package_update: true
packages: [curl, ca-certificates, jq]
runcmd:
  - [ sh, -c, "curl -fsSL https://get.docker.com | sh" ]
  - [ sh, -c, "usermod -aG docker ubuntu 2>/dev/null || true" ]
'

die() { echo "error: $*" >&2; exit 1; }
info() { echo "  $*"; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed."
}

load_token() {
  if [ -f .env ]; then set -a; . ./.env; set +a; fi
  [ -n "${HETZNER_TOKEN:-}" ] || die "No HETZNER_TOKEN. Put it in .env — see .env.example."
}

# curl exits 0 on an HTTP 4xx/5xx unless told otherwise, which is how a failed
# delete can look like a successful one. Capture the status code and fail loudly.
api() {
  local method="$1" path="$2" body="${3:-}" resp code payload
  if [ -n "$body" ]; then
    resp=$(curl -sS -w $'\n%{http_code}' -X "$method" \
      -H "Authorization: Bearer $HETZNER_TOKEN" -H "Content-Type: application/json" \
      -d "$body" "$API$path") || return 1
  else
    resp=$(curl -sS -w $'\n%{http_code}' -X "$method" \
      -H "Authorization: Bearer $HETZNER_TOKEN" "$API$path") || return 1
  fi
  code="${resp##*$'\n'}"
  payload="${resp%$'\n'*}"
  if [ "$code" -ge 400 ]; then
    echo "HTTP $code from $method $path: $payload" >&2
    return 1
  fi
  echo "$payload"
}

# Hetzner returns {"error": {...}} on failure with a 2xx-looking body in places,
# so check explicitly rather than trusting the exit code.
check() {
  local json="$1" what="$2"
  if echo "$json" | jq -e '.error' >/dev/null 2>&1; then
    die "$what failed: $(echo "$json" | jq -r '.error.message')"
  fi
}

# Find a resource by name, or create it. Returns its id on stdout.
find_or_create() {
  local kind="$1" create_body="$2" existing
  existing=$(api GET "/$kind?name=$NAME" | jq -r ".${kind}[0].id // empty")
  if [ -n "$existing" ]; then
    echo "$existing"; return
  fi
  local out
  out=$(api POST "/$kind" "$create_body")
  check "$out" "creating $kind"
  echo "$out" | jq -r ".${kind%s}.id"
}

# A keypair dedicated to this node, rather than your personal one. Same instinct
# as using a fresh wallet for a risky contract interaction.
ensure_ssh_key() {
  mkdir -p "$STATE_DIR"
  if [ ! -f "$SSH_KEY" ]; then
    info "generating a dedicated SSH keypair (not reusing your personal one)"
    ssh-keygen -t ed25519 -f "$SSH_KEY" -N "" -C "$NAME" -q
    chmod 600 "$SSH_KEY"
  fi
}

cmd_provision() {
  case "$PROVIDER" in
    aws)     provision_aws "$@" ;;
    hetzner) provision_hetzner "$@" ;;
    *) die "unknown SNAPSTART_PROVIDER '$PROVIDER' (expected aws or hetzner)" ;;
  esac
}

aws_ec2() { aws ec2 --region "$AWS_REGION" --output json "$@"; }

provision_aws() {
  need aws; need jq; need ssh-keygen
  ensure_ssh_key

  aws sts get-caller-identity >/dev/null 2>&1 \
    || die "AWS credentials are not configured. Run: aws configure"

  info "region $AWS_REGION"

  # Pre-flight the vCPU quota before creating anything.
  #
  # New AWS accounts ship with a low on-demand vCPU limit — as little as 5 — and
  # m5.xlarge is 4 vCPUs. Discovering that after the security group and key pair
  # exist means a confusing VcpuLimitExceeded halfway through. This is the same
  # class of failure as Hetzner's volume cap, so check it the same way: early,
  # and with an explanation rather than a raw API error.
  local vcpu_quota vcpus_needed=4
  vcpu_quota=$(aws service-quotas get-service-quota --region "$AWS_REGION" \
    --service-code ec2 --quota-code L-1216C47A \
    --query 'Quota.Value' --output text 2>/dev/null || echo "")
  if [ -n "$vcpu_quota" ] && [ "$vcpu_quota" != "None" ]; then
    local quota_int; quota_int=${vcpu_quota%.*}
    info "on-demand vCPU quota: $quota_int (need $vcpus_needed)"
    if [ "$quota_int" -lt "$vcpus_needed" ] 2>/dev/null; then
      die "Your AWS account's on-demand vCPU quota is $quota_int, but $AWS_INSTANCE_TYPE needs $vcpus_needed.

New accounts are often capped low. Request an increase for 'Running On-Demand
Standard instances' in the Service Quotas console, or pick a smaller instance:

    SNAPSTART_AWS_INSTANCE_TYPE=m5.large ./snapstart provision

Nothing has been created, and you have not been billed."
    fi
  else
    info "on-demand vCPU quota: could not read (continuing)"
  fi

  # Import our own public key rather than letting AWS generate one — that way the
  # private half never exists anywhere but this machine.
  if ! aws_ec2 describe-key-pairs --key-names "$NAME" >/dev/null 2>&1; then
    info "ssh key"
    aws_ec2 import-key-pair --key-name "$NAME" \
      --public-key-material "fileb://$SSH_KEY.pub" >/dev/null
  else
    info "ssh key (exists)"
  fi

  # Only what peers actually need: 3382/udp for gossip and 3383/tcp for sync.
  # 3381 is the client-facing HTTP API and stays closed — reach it via
  # ./snapstart tunnel rather than exposing an unauthenticated RPC endpoint.
  local sg_id
  sg_id=$(aws_ec2 describe-security-groups --group-names "$NAME" \
            --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null || true)
  if [ -z "$sg_id" ] || [ "$sg_id" = "None" ]; then
    info "security group (22/tcp, 3382/udp, 3383/tcp)"
    sg_id=$(aws_ec2 create-security-group --group-name "$NAME" \
      --description "snapstart snapchain read node" \
      --query 'GroupId' --output text)
    local ssh_from="${SNAPSTART_SSH_FROM:-0.0.0.0/0}"
    aws_ec2 authorize-security-group-ingress --group-id "$sg_id" \
      --ip-permissions \
        "IpProtocol=tcp,FromPort=22,ToPort=22,IpRanges=[{CidrIp=$ssh_from}]" \
        "IpProtocol=udp,FromPort=3382,ToPort=3382,IpRanges=[{CidrIp=0.0.0.0/0}]" \
        "IpProtocol=tcp,FromPort=3383,ToPort=3383,IpRanges=[{CidrIp=0.0.0.0/0}]" \
      >/dev/null
  else
    info "security group (exists)"
  fi

  # Canonical's account ID. Resolving the AMI by name beats hardcoding an ID that
  # differs per region and goes stale with every image rebuild.
  local ami
  ami=$(aws_ec2 describe-images --owners 099720109477 \
    --filters "Name=name,Values=ubuntu/images/hvm-ssd*/ubuntu-noble-24.04-amd64-server-*" \
              "Name=state,Values=available" \
    --query 'sort_by(Images,&CreationDate)[-1].ImageId' --output text)
  [ -n "$ami" ] && [ "$ami" != "None" ] || die "could not resolve an Ubuntu 24.04 AMI in $AWS_REGION"
  info "ami $ami"

  local instance_id
  instance_id=$(aws_ec2 describe-instances \
    --filters "Name=tag:Name,Values=$NAME" "Name=instance-state-name,Values=pending,running" \
    --query 'Reservations[0].Instances[0].InstanceId' --output text 2>/dev/null || true)

  if [ -z "$instance_id" ] || [ "$instance_id" = "None" ]; then
    info "instance ($AWS_INSTANCE_TYPE, ${AWS_DISK_GB} GB root)"
    # The root volume carries everything. No separate EBS volume means nothing to
    # attach, format, mount, or forget to mount — the single biggest simplification
    # over the Hetzner path.
    local run_out
    if ! run_out=$(aws_ec2 run-instances \
      --image-id "$ami" \
      --instance-type "$AWS_INSTANCE_TYPE" \
      --key-name "$NAME" \
      --security-group-ids "$sg_id" \
      --block-device-mappings "[{\"DeviceName\":\"/dev/sda1\",\"Ebs\":{\"VolumeSize\":$AWS_DISK_GB,\"VolumeType\":\"gp3\",\"DeleteOnTermination\":true}}]" \
      --user-data "$CLOUD_INIT" \
      --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=$NAME}]" \
      --query 'Instances[0].InstanceId' --output text 2>&1); then

      # Accounts created after 2025-07-15 land on the AWS "Free Plan", which does
      # not merely cap spending — it refuses to launch any instance type that is
      # not free-tier eligible. The largest eligible type is m7i-flex.large at
      # 2 vCPU / 8 GiB, and snapchain needs 4 vCPU / 16 GiB, so no eligible type
      # can run a node. This is not a quota you can request an increase for.
      if echo "$run_out" | grep -q "not eligible for Free Tier"; then
        die "Your AWS account is on the Free Plan, which cannot launch $AWS_INSTANCE_TYPE.

The Free Plan only permits free-tier-eligible instance types. The largest of those
is m7i-flex.large (2 vCPU, 8 GiB) and Snapchain needs 4 vCPU and 16 GiB, so no
eligible type is large enough. Raising a quota will not help.

Upgrade to a Paid Plan in the Billing and Cost Management console, then re-run
this command. Your free credits still apply — they offset the bill rather than
being forfeited.

Nothing has been created, and you have not been billed."
      fi

      if echo "$run_out" | grep -qi "VcpuLimitExceeded"; then
        die "Your account's on-demand vCPU limit is too low for $AWS_INSTANCE_TYPE.

Request an increase for 'Running On-Demand Standard instances' in the Service
Quotas console. Nothing has been created."
      fi

      die "run-instances failed: $run_out"
    fi
    instance_id="$run_out"
  else
    info "instance (exists)"
  fi

  # Persist before waiting for anything. The instance is billing from the moment
  # it exists, so its id has to be on disk even if every later step fails —
  # otherwise destroy has nothing to work with.
  jq -n --arg provider aws --arg iid "$instance_id" \
     --arg region "$AWS_REGION" --arg type "$AWS_INSTANCE_TYPE" --argjson gb "$AWS_DISK_GB" \
     '{provider:$provider,instance_id:$iid,region:$region,server_type:$type,disk_gb:$gb}' \
     | write_state

  info "waiting for the instance to run"
  aws_ec2 wait instance-running --instance-ids "$instance_id" \
    || die "instance never reached running state. It may still be billing: ./snapstart destroy"

  local ip
  ip=$(aws_ec2 describe-instances --instance-ids "$instance_id" \
        --query 'Reservations[0].Instances[0].PublicIpAddress' --output text)
  [ -n "$ip" ] && [ "$ip" != "None" ] \
    || die "instance has no public IP. It is billing: ./snapstart destroy"
  info "ip $ip"
  update_state --arg ip "$ip" '.ip = $ip'

  info "waiting for ssh"
  local ready=""
  for _ in $(seq 1 90); do
    if ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 \
         -o BatchMode=yes "ubuntu@$ip" true 2>/dev/null; then ready=1; break; fi
    sleep 5
  done
  [ -n "$ready" ] || die "ssh never came up on $ip"

  info "waiting for docker (cloud-init)"
  for _ in $(seq 1 90); do
    node_ssh "cloud-init status 2>/dev/null | grep -q done" 2>/dev/null && break
    sleep 5
  done

  # Snapchain's data lives here on every provider, so node up stays identical.
  node_ssh "sudo mkdir -p /mnt/snapchain && sudo chown \$(id -u):\$(id -g) /mnt/snapchain" \
    || die "could not prepare /mnt/snapchain"

  echo
  info "provisioned. details in $STATE_FILE"
  cmd_status
  echo
  info "next: ./snapstart node up"
}

provision_hetzner() {
  need curl; need jq; need ssh-keygen
  load_token
  ensure_ssh_key

  info "ssh key"
  local key_id
  key_id=$(find_or_create ssh_keys \
    "$(jq -n --arg n "$NAME" --arg k "$(cat "$SSH_KEY.pub")" '{name:$n,public_key:$k}')")

  # The docs say to expose 3381-3383 on both TCP and UDP. Checking what actually
  # listens on a running node, only three of those six combinations are used:
  #
  #   3381/tcp  HTTP API   — client-facing; peers never call it, so keep it CLOSED
  #                          and reach it through ./snapstart tunnel instead
  #   3382/udp  gossip     — must be public for peering
  #   3383/tcp  peer sync  — must be public
  #
  # Worth knowing: grafana also binds 0.0.0.0:3000 and statsd 0.0.0.0:8125. Nothing
  # in snapchain stops that, so on a host without a cloud firewall they are simply
  # exposed. Here the firewall is the only thing keeping them private.
  local ssh_from="${SNAPSTART_SSH_FROM:-0.0.0.0/0}"
  info "firewall (22/tcp from $ssh_from, 3382/udp + 3383/tcp)"
  local fw_id
  fw_id=$(find_or_create firewalls "$(jq -n --arg n "$NAME" --arg ssh "$ssh_from" \
    '{name:$n,rules:[{direction:"in",protocol:"tcp",port:"22",source_ips:[$ssh],description:"ssh"}]}')")

  # find_or_create will not touch an existing firewall's rules, so set them
  # explicitly — otherwise a firewall from an earlier run keeps its old, wider rules.
  api POST "/firewalls/$fw_id/actions/set_rules" "$(jq -n --arg ssh "$ssh_from" '{
    rules:[
      {direction:"in",protocol:"tcp",port:"22",source_ips:[$ssh],description:"ssh"},
      {direction:"in",protocol:"udp",port:"3382",source_ips:["0.0.0.0/0","::/0"],description:"snapchain gossip"},
      {direction:"in",protocol:"tcp",port:"3383",source_ips:["0.0.0.0/0","::/0"],description:"snapchain peer sync"},
      {direction:"in",protocol:"icmp",source_ips:["0.0.0.0/0","::/0"],description:"ping"}
    ]}')" >/dev/null || die "could not set firewall rules"

  info "server ($SERVER_TYPE, $LOCATION)"
  local server_id
  server_id=$(find_or_create servers "$(jq -n \
    --arg n "$NAME" --arg t "$SERVER_TYPE" --arg l "$LOCATION" --arg i "$IMAGE" \
    --argjson k "$key_id" --argjson f "$fw_id" \
    --arg ud '#cloud-config
package_update: true
packages: [curl, ca-certificates, jq]
runcmd:
  - [ sh, -c, "curl -fsSL https://get.docker.com | sh" ]
' '{
      name:$n, server_type:$t, location:$l, image:$i,
      ssh_keys:[$k], firewalls:[{firewall:$f}],
      public_net:{enable_ipv4:true,enable_ipv6:true},
      user_data:$ud
    }')")

  # Persist the server id immediately. Everything after this — IP assignment,
  # volume creation, the quota check — can fail, and the server bills regardless.
  # Recording it first is what makes the "run ./snapstart destroy" advice in
  # those failure messages actually true.
  jq -n --arg provider hetzner --argjson sid "$server_id" \
     --arg type "$SERVER_TYPE" --arg loc "$LOCATION" --argjson gb "$VOLUME_GB" \
     '{provider:$provider,server_id:$sid,server_type:$type,location:$loc,volume_gb:$gb}' \
     | write_state

  # Wait for an IP before attaching storage.
  local ip=""
  for _ in $(seq 1 60); do
    ip=$(api GET "/servers/$server_id" | jq -r '.server.public_net.ipv4.ip // empty')
    [ -n "$ip" ] && break
    sleep 2
  done
  [ -n "$ip" ] || die "server never got an IPv4 address. It is billing: ./snapstart destroy"
  info "ip $ip"
  update_state --arg ip "$ip" '.ip = $ip'

  info "volume (${VOLUME_GB} GB)"
  local vol_id existing_vol
  existing_vol=$(api GET "/volumes?name=$NAME" | jq -r '.volumes[0].id // empty')
  if [ -n "$existing_vol" ]; then
    vol_id="$existing_vol"
  else
    local out
    # Hetzner caps volume storage per account, and new accounts sit below the
    # snapchain docs' recommended 2 TB — this account's ceiling is 1024 GB, found
    # by probing a resize to 1030 GB. A tutorial that dies here with a raw API
    # error strands people with a half-built, billing server, so say what happened
    # and what to do about it.
    if ! out=$(api POST /volumes "$(jq -n --arg n "$NAME" --argjson s "$VOLUME_GB" --argjson srv "$server_id" \
      '{name:$n,size:$s,server:$srv,automount:true,format:"ext4"}')" 2>&1); then
      if echo "$out" | grep -q resource_limit_exceeded; then
        die "Hetzner refused a ${VOLUME_GB} GB volume: your account's storage quota is lower.

New Hetzner accounts are commonly capped at 1024 GB. Either ask Hetzner support to
raise it, or provision within the cap:

    SNAPSTART_VOLUME_GB=1024 ./snapstart provision

The server has been created and IS BILLING. Remove it with:

    ./snapstart destroy"
      fi
      die "creating volume failed: $out"
    fi
    check "$out" "creating volume"
    vol_id=$(echo "$out" | jq -r '.volume.id')
  fi
  update_state --argjson vid "$vol_id" '.volume_id = $vid'

  local mount
  mount=$(api GET "/volumes/$vol_id" | jq -r '.volume.linux_device // empty')

  info "waiting for ssh"
  local ready=""
  for _ in $(seq 1 60); do
    if ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 \
         -o BatchMode=yes "root@$ip" true 2>/dev/null; then ready=1; break; fi
    sleep 5
  done
  [ -n "$ready" ] || die "ssh never came up on $ip"

  # Hetzner's automount:true is documented to mount the volume for you. It does not
  # fire when the volume is created against an already-booted server, and fails
  # silently — the device shows up under /dev/disk/by-id and is simply never
  # mounted. Do it ourselves rather than trusting it.
  #
  # nofail matters: without it, a detached volume makes the server unbootable.
  info "mounting volume at /mnt/snapchain"
  ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new -o BatchMode=yes "root@$ip" "
    set -e
    dev=/dev/disk/by-id/scsi-0HC_Volume_$vol_id
    for _ in \$(seq 1 30); do [ -e \"\$dev\" ] && break; sleep 2; done
    [ -e \"\$dev\" ] || { echo 'volume device never appeared'; exit 1; }
    blkid \"\$dev\" >/dev/null 2>&1 || mkfs.ext4 -F \"\$dev\"
    mkdir -p /mnt/snapchain
    grep -q ' /mnt/snapchain ' /etc/fstab || \
      echo \"\$dev /mnt/snapchain ext4 discard,nofail,defaults 0 0\" >> /etc/fstab
    mountpoint -q /mnt/snapchain || mount -a
  " || die "failed to mount volume"

  # Docker arrives via cloud-init; ./snapstart node up needs it present.
  info "waiting for docker (cloud-init)"
  for _ in $(seq 1 60); do
    ssh -i "$SSH_KEY" -o BatchMode=yes "root@$ip" \
      "cloud-init status 2>/dev/null | grep -q done" 2>/dev/null && break
    sleep 5
  done

  # Merge rather than overwrite: the ids were recorded as they were created, and
  # rewriting the whole file here would reintroduce a window where a crash loses
  # them.
  update_state --arg dev "$mount" '.device = $dev'

  echo
  info "provisioned. details in $STATE_FILE"
  cmd_status
  echo
  info "next: ./snapstart node up"
}

cmd_status() {
  need jq
  [ -f "$STATE_FILE" ] || die "nothing provisioned yet. Run ./snapstart provision"
  case "$(jq -r '.provider // "hetzner"' "$STATE_FILE")" in
    aws) status_aws ;;
    *)   status_hetzner ;;
  esac
}

status_aws() {
  need aws
  local iid ip region type gb state
  iid=$(jq -r .instance_id "$STATE_FILE"); ip=$(jq -r .ip "$STATE_FILE")
  region=$(jq -r .region "$STATE_FILE"); type=$(jq -r .server_type "$STATE_FILE")
  gb=$(jq -r .disk_gb "$STATE_FILE")
  state=$(aws ec2 --region "$region" describe-instances --instance-ids "$iid" \
            --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo unknown)

  echo
  printf "  %-12s %s\n" "provider" "aws ($region)"
  printf "  %-12s %s\n" "status" "$state"
  printf "  %-12s %s\n" "ip" "$ip"
  printf "  %-12s %s\n" "type" "$type"
  printf "  %-12s %s GB gp3 root\n" "disk" "$gb"
  # On-demand us-east-1 list rates. AWS's pricing API needs a separate endpoint
  # and its own permissions, so these are stated rather than queried — check the
  # console for your own account's actual rate.
  local inst_hr="0.192" disk_hr
  disk_hr=$(awk -v gb="$gb" 'BEGIN{printf "%.4f", gb*0.08/730}')
  printf "  %-12s USD %.4f/hr  (instance ~%s + disk %.4f)\n" "cost" \
    "$(awk -v a="$inst_hr" -v b="$disk_hr" 'BEGIN{print a+b}')" "$inst_hr" "$disk_hr"
  printf "  %-12s USD %.2f\n" "per day" \
    "$(awk -v a="$inst_hr" -v b="$disk_hr" 'BEGIN{print (a+b)*24}')"
}

status_hetzner() {
  need jq; load_token
  local sid vid ip
  sid=$(jq -r .server_id "$STATE_FILE"); vid=$(jq -r .volume_id "$STATE_FILE")
  ip=$(jq -r .ip "$STATE_FILE")

  local s v shr vhr
  s=$(api GET "/servers/$sid"); v=$(api GET "/volumes/$vid")
  shr=$(echo "$s" | jq -r --arg l "$(jq -r .location "$STATE_FILE")" \
        '.server.server_type.prices[] | select(.location==$l) | .price_hourly.gross')
  vhr=$(echo "$v" | jq -r '.volume.size' )

  echo
  printf "  %-12s %s\n" "status" "$(echo "$s" | jq -r '.server.status')"
  printf "  %-12s %s\n" "ip" "$ip"
  printf "  %-12s %s\n" "type" "$(echo "$s" | jq -r '.server.server_type.name')"
  printf "  %-12s %s GB on %s\n" "volume" "$vhr" "$(echo "$v" | jq -r '.volume.linux_device')"
  # Volume pricing is per-GB-month; /730 for an hourly figure comparable to the server.
  local vol_hr
  vol_hr=$(api GET /pricing | jq -r --argjson gb "$vhr" \
    '(.pricing.volume.price_per_gb_month.gross|tonumber) * $gb / 730')
  printf "  %-12s EUR %.4f/hr  (server %.4f + volume %.4f)\n" "cost" \
    "$(echo "$shr $vol_hr" | awk '{print $1+$2}')" "$shr" "$vol_hr"
  printf "  %-12s EUR %.2f\n" "per day" "$(echo "$shr $vol_hr" | awk '{print ($1+$2)*24}')"
}

# AWS's Ubuntu images ship with an unprivileged `ubuntu` user and no root login;
# Hetzner's let you in as root. Read it back from state so every other command
# stays provider-agnostic.
node_user() {
  [ -f "$STATE_FILE" ] || { echo root; return; }
  case "$(jq -r '.provider // "hetzner"' "$STATE_FILE")" in
    aws) echo ubuntu ;;
    *)   echo root ;;
  esac
}

node_ssh() {
  [ -f "$STATE_FILE" ] || die "nothing provisioned yet. Run ./snapstart provision"
  # The install step can run for many minutes with no output. Without keepalives
  # the link times out mid-command and ssh returns non-zero for a step that
  # actually succeeded.
  ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new -o BatchMode=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=20 \
    "$(node_user)@$(jq -r .ip "$STATE_FILE")" "$@"
}

cmd_node_up() {
  need jq; need ssh
  [ -f "$STATE_FILE" ] || die "nothing provisioned yet. Run ./snapstart provision"
  if [ -f .env ]; then set -a; . ./.env; set +a; fi

  # Only used to label the node's metrics as yours. It is not an authorization of
  # any kind and the node works fine with 0.
  local operator_fid="${TEST_FID:-0}"

  # Running this against a node that is already up is not harmless: `snapchain.sh
  # upgrade` runs `docker compose up`, which RECREATES the container, and a restart
  # mid-restore throws away snapshot progress and starts over from chunk 0. Observed
  # the hard way — it cost ~15 minutes and looked like a shard rollover in the logs.
  if [ "${1:-}" != "--force" ] && node_ssh "docker ps --format '{{.Names}}' | grep -q snapchain" 2>/dev/null; then
    info "node is already running; leaving it alone"
    info "(use ./snapstart node up --force to recreate it, which restarts any restore in progress)"
    echo
    cmd_node_status
    return 0
  fi

  info "installing snapchain (operator fid $operator_fid)"
  node_ssh "
    set -e
    # Snapshot data goes on the volume. The root disk is 150 GB and the snapshot
    # alone is larger than that, so this symlink is load-bearing.
    mkdir -p /mnt/snapchain/snapchain
    ln -sfn /mnt/snapchain/snapchain \$HOME/snapchain
    cd \$HOME/snapchain

    curl -sSL -o snapchain.sh \
      https://raw.githubusercontent.com/farcasterxyz/snapchain/refs/heads/main/scripts/snapchain.sh
    chmod +x snapchain.sh

    # Upstream's bootstrap prompts for an operator FID and a rewards acknowledgement
    # on a TTY. It only prompts for keys that are MISSING from .env, so writing them
    # up front makes the whole thing non-interactive — which is what lets this be
    # one command instead of an interactive session.
    #
    # read_node is snapchain's default: validators are permissioned behind a key in
    # the SnapchainConfigRegistry on Ethereum mainnet, so a read node is simply what
    # you get. No RPC URL, no API key, nothing to sign up for.
    if [ ! -f .env ]; then
      cat > .env <<ENVEOF
FC_NETWORK_ID=1
STATSD_METRICS_SERVER=statsd:8125
HUB_OPERATOR_FID=$operator_fid
AGREE_NO_REWARDS_FOR_ME=true
SKIP_CRONTAB=1
ENVEOF
    fi

    # The upgrade script does not reliably exit once containers are healthy, so bound
    # it and judge success by what is actually running rather than by its exit code.
    timeout 900 ./snapchain.sh upgrade >/tmp/snapchain-upgrade.log 2>&1 || true
    docker ps --format '{{.Names}}' | grep -q snapchain || {
      echo 'snapchain container did not start; see /tmp/snapchain-upgrade.log'
      tail -20 /tmp/snapchain-upgrade.log
      exit 1
    }
  " || {
    # Losing the connection is not the same as the node failing to start. The
    # upgrade step is long and silent, and the far side keeps running after the
    # link drops — observed on a from-zero run: ssh reported a broken pipe while
    # the restore was already underway. Reconnect and judge by what is running.
    info "lost the connection during install — checking whether the node came up anyway"
    sleep 10
    if node_ssh "docker ps --format '{{.Names}}' | grep -q snapchain" >/dev/null 2>&1; then
      info "it did: snapchain is running"
    else
      die "node failed to start"
    fi
  }

  info "node started; restoring from snapshot"
  echo
  cmd_node_status
  echo
  info "the restore takes a while. Watch it with: ./snapstart node status"
}

cmd_node_status() {
  need jq
  [ -f "$STATE_FILE" ] || die "nothing provisioned yet."
  node_ssh "
    printf '  %-12s %s\n' 'data' \"\$(du -sh /mnt/snapchain/snapchain 2>/dev/null | cut -f1)\"
    printf '  %-12s %s\n' 'disk' \"\$(df -h /mnt/snapchain | tail -1 | awk '{print \$3\" used, \"\$4\" free (\"\$5\")\"}')\"
    # Running out of disk mid-restore leaves a broken node and wastes hours, so
    # say something well before it happens. The volume can be grown without
    # destroying anything: resize it in the cloud console, then resize2fs.
    used_pct=\$(df --output=pcent /mnt/snapchain | tail -1 | tr -dc '0-9')
    if [ \"\${used_pct:-0}\" -ge 80 ]; then
      printf '  %-12s %s\n' 'WARNING' \"volume is \${used_pct}%% full — grow it before it fills\"
      printf '  %-12s %s\n' '' 'hcloud volume resize, then: resize2fs /dev/sdb'
    fi
    printf '  %-12s %s\n' 'containers' \"\$(docker ps --format '{{.Names}}' | tr '\n' ' ')\"
    info=\$(curl -s --max-time 5 http://localhost:3381/v1/info 2>/dev/null || true)
    if [ -n \"\$info\" ]; then
      echo \"\$info\" | jq -r '\"  serving      yes\n  block height \" + (.dbStats.numMessages|tostring)' 2>/dev/null \
        || printf '  %-12s %s\n' 'serving' 'yes'
    else
      printf '  %-12s %s\n' 'serving' 'not yet (snapshot still restoring)'
      last=\$(docker logs --tail 40 snapchain-snapchain-1 2>&1 | grep -o 'chunk_[0-9]*' | tail -1)
      [ -n \"\$last\" ] && printf '  %-12s %s\n' 'restoring' \"\$last\"
    fi
  "
}

cmd_node_logs() { node_ssh "docker logs --tail \${1:-40} -f snapchain-snapchain-1 2>&1"; }

# Is this node actually usable, per shard?
#
# "The API responds" and "the database has data" are both weaker than they look.
# A node whose shard 0 never restored serves /v1/info happily, reports hundreds
# of millions of messages, answers every read correctly — and silently rejects
# every write, because KEY_ADD routes to shard 0 and the block engine there has
# no registration state. We lost hours to exactly that.
#
# Readiness means every shard the network has is present AND close to the tip.
cmd_node_ready() {
  need jq
  [ -f "$STATE_FILE" ] || die "nothing provisioned yet."

  # `|| true`: a node that is still restoring refuses the connection, and curl's
  # non-zero exit would otherwise abort under `set -e` before we can say so.
  local info
  info=$(node_ssh "curl -s --max-time 8 http://localhost:3381/v1/info" 2>/dev/null || true)
  if [ -z "$info" ] || ! echo "$info" | jq -e .shardInfos >/dev/null 2>&1; then
    echo "  not ready: node is not serving (still restoring, or down)"
    echo "  watch with: ./snapstart node status"
    return 1
  fi

  # blockDelay is roughly blocks behind the tip, and blocks are ~1s apart, so
  # this threshold is about "within a couple of minutes".
  local max_delay="${SNAPSTART_MAX_BLOCK_DELAY:-100}"
  local lagging=0

  echo
  printf "  %-8s %14s %14s %16s  %s\n" "shard" "height" "delay" "messages" "state"
  while IFS=$'\t' read -r id height delay msgs; do
    local state="ok"
    if [ "$delay" -gt "$max_delay" ] 2>/dev/null; then
      state="LAGGING (~$((delay / 60))m behind)"
      lagging=1
    fi
    printf "  %-8s %14s %14s %16s  %s\n" "$id" "$height" "$delay" "$msgs" "$state"
  done < <(echo "$info" | jq -r '.shardInfos | sort_by(.shardId)[] | [.shardId, .maxHeight, .blockDelay, .numMessages] | @tsv')

  # Shard 0 carries gasless keys and storage lends. It holds no user messages, so
  # a message-count check would call an empty shard 0 healthy — it is the exact
  # shard that fails silently.
  if ! echo "$info" | jq -e '.shardInfos[] | select(.shardId == 0)' >/dev/null 2>&1; then
    echo
    echo "  not ready: shard 0 is absent. Writes will fail — KEY_ADD routes there."
    return 1
  fi

  echo
  if [ "$lagging" = 1 ]; then
    echo "  NOT READY: at least one shard is behind the tip."
    echo "  Reads may look fine while writes fail. Wait, or re-bootstrap."
    return 1
  fi
  echo "  ready: all shards present and within $max_delay blocks of the tip"
}

# Forward the node's HTTP port to localhost rather than opening 3381 to the world.
# The firewall deliberately exposes 3381-3383 for gossip, but an RPC endpoint that
# anyone can query (or submit to) is a different matter — and grafana on :3000 is
# not exposed at all. Tunnelling keeps the client's view private without widening
# the firewall.
# Issues this client its own app key. The seed phrase is prompted for, used
# once, and never written anywhere — only the resulting Ed25519 key is saved.
cmd_client_create() {
  command -v node >/dev/null || die "node is required"
  if ! curl -s --max-time 3 http://127.0.0.1:3381/v1/info >/dev/null 2>&1; then
    die "Nothing is answering on 127.0.0.1:3381.

Open the tunnel in another terminal first:

    ./snapstart tunnel"
  fi
  exec npm run --silent client-create
}

# The UI runs HERE, on your machine, bound to 127.0.0.1. It reaches the node
# through the tunnel. Nothing is exposed: no port is opened on the node, and no
# password is needed because nothing off this machine can reach it.
cmd_client_ui() {
  need npx
  command -v node >/dev/null || die "node is required for the client UI"
  if ! curl -s --max-time 3 http://127.0.0.1:3381/v1/info >/dev/null 2>&1; then
    info "note: nothing is answering on 127.0.0.1:3381 — open ./snapstart tunnel in another"
    info "      terminal, or the UI will start but show the node as unreachable"
  fi
  exec npm run --silent ui
}

cmd_tunnel() {
  need jq
  [ -f "$STATE_FILE" ] || die "nothing provisioned yet."
  local ip; ip=$(jq -r .ip "$STATE_FILE")
  info "forwarding localhost:3381 -> $ip:3381 (ctrl-c to stop)"
  exec ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new -N \
    -L 3381:localhost:3381 "$(node_user)@$ip"
}

# Grow the data volume without destroying anything.
#
# Needed more often than you would hope: the restore holds the compressed chunks
# AND the unpacked database at the same time — chunks are not deleted as they are
# unzipped — so peak usage is far above the final footprint.
#
# Hetzner volumes can only ever grow, never shrink. Resizing the volume is online
# and safe; resize2fs then extends the filesystem over the new space, also online.
cmd_volume_grow() {
  need jq
  local new_gb="${1:-}"
  [ -n "$new_gb" ] || die "usage: ./snapstart volume grow <GB>"
  [ -f "$STATE_FILE" ] || die "nothing provisioned yet."
  [ "$(jq -r '.provider // "hetzner"' "$STATE_FILE")" = "hetzner" ] \
    || die "volume grow is Hetzner-only. On AWS the root volume is sized at
provision time — set SNAPSTART_DISK_GB and reprovision, or modify the volume in
the EC2 console and run: sudo growpart /dev/nvme0n1 1 && sudo resize2fs /dev/nvme0n1p1"
  load_token

  local vid current
  vid=$(jq -r .volume_id "$STATE_FILE")
  current=$(api GET "/volumes/$vid" | jq -r '.volume.size')
  [ "$new_gb" -gt "$current" ] || die "volume is already ${current} GB; it cannot shrink."

  info "growing volume $current GB -> $new_gb GB"
  api POST "/volumes/$vid/actions/resize" "$(jq -n --argjson s "$new_gb" '{size:$s}')" >/dev/null \
    || die "resize failed"

  # The cloud-side resize is async; wait for it to report the new size.
  for _ in $(seq 1 60); do
    [ "$(api GET "/volumes/$vid" | jq -r '.volume.size')" = "$new_gb" ] && break
    sleep 5
  done

  info "extending filesystem (online, node keeps running)"
  node_ssh "
    set -e
    dev=/dev/disk/by-id/scsi-0HC_Volume_$vid
    e2fsck -f -p \"\$dev\" >/dev/null 2>&1 || true
    resize2fs \"\$dev\"
    df -h /mnt/snapchain | tail -1
  " || die "filesystem resize failed"

  jq --argjson gb "$new_gb" '.volume_gb = $gb' "$STATE_FILE" > "$STATE_FILE.tmp" \
    && mv "$STATE_FILE.tmp" "$STATE_FILE"
  info "done"
}

cmd_ssh() {
  need jq
  [ -f "$STATE_FILE" ] || die "nothing provisioned yet."
  exec ssh -i "$SSH_KEY" -o StrictHostKeyChecking=accept-new \
    "$(node_user)@$(jq -r .ip "$STATE_FILE")" "$@"
}

cmd_destroy() {
  need jq
  [ -f "$STATE_FILE" ] || die "nothing to destroy."

  # Name what is about to die. The confirmation string is identical across
  # providers, so a prompt that only says "snapstart-node" gives no way to tell
  # which machine you are about to destroy when two exist.
  echo
  echo "About to destroy:"
  printf "  %-10s %s\n" "provider" "$(jq -r '.provider // "hetzner"' "$STATE_FILE")"
  printf "  %-10s %s\n" "ip" "$(jq -r '.ip // "unknown"' "$STATE_FILE")"
  printf "  %-10s %s\n" "state" "$STATE_FILE"
  echo
  echo "The restored database goes with it — a fresh node re-syncs from scratch."
  read -rp "Type the server name ($NAME) to confirm: " confirm
  [ "$confirm" = "$NAME" ] || die "aborted."
  case "$(jq -r '.provider // "hetzner"' "$STATE_FILE")" in
    aws) destroy_aws ;;
    *)   destroy_hetzner ;;
  esac
}

destroy_aws() {
  need aws
  local iid region
  iid=$(jq -r .instance_id "$STATE_FILE"); region=$(jq -r .region "$STATE_FILE")

  # Capture the attached volumes BEFORE terminating. Afterwards the instance no
  # longer reports them, so there is no way to check whether they actually went.
  local volumes
  volumes=$(aws ec2 --region "$region" describe-instances --instance-ids "$iid" \
    --query 'Reservations[0].Instances[0].BlockDeviceMappings[].Ebs.VolumeId' \
    --output text 2>/dev/null || true)

  aws ec2 --region "$region" terminate-instances --instance-ids "$iid" >/dev/null \
    || die "terminate failed; $STATE_FILE kept so you can retry. Check the EC2 console."

  info "waiting for termination"
  aws ec2 --region "$region" wait instance-terminated --instance-ids "$iid" 2>/dev/null || true

  local failed=0 state
  state=$(aws ec2 --region "$region" describe-instances --instance-ids "$iid" \
            --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo gone)
  if [ "$state" = "terminated" ] || [ "$state" = "gone" ]; then
    info "instance terminated"
  else
    info "INSTANCE IS '$state', NOT TERMINATED (id $iid)"; failed=1
  fi

  # The 2 TB root volume is the expensive part — about $160/month if it survives.
  # DeleteOnTermination is supposed to take it, but "supposed to" is how you end
  # up paying for storage attached to nothing. Check each one.
  local v vstate
  for v in $volumes; do
    [ -n "$v" ] || continue
    vstate=$(aws ec2 --region "$region" describe-volumes --volume-ids "$v" \
              --query 'Volumes[0].State' --output text 2>/dev/null || echo gone)
    if [ "$vstate" = "gone" ] || [ "$vstate" = "deleted" ] || [ "$vstate" = "deleting" ]; then
      info "volume $v deleted"
    else
      info "VOLUME $v STILL EXISTS ($vstate) — IT IS BILLING"; failed=1
    fi
  done

  if [ "$failed" = 1 ]; then
    echo
    echo "Teardown did NOT fully succeed. $STATE_FILE has been kept so you can retry." >&2
    echo "Check https://console.aws.amazon.com/ec2/ and confirm nothing is still billing." >&2
    exit 1
  fi

  rm -f "$STATE_FILE"
  info "done. The security group and key pair remain (both free); delete them in"
  info "the console if you want the account completely clean."
}

destroy_hetzner() {
  load_token
  local sid vid failed=0
  sid=$(jq -r .server_id "$STATE_FILE"); vid=$(jq -r .volume_id "$STATE_FILE")

  api DELETE "/servers/$sid" >/dev/null || failed=1
  # A volume cannot be deleted while it is still attached, and detaching is not
  # instant after the server goes away.
  local detached=0
  for _ in $(seq 1 30); do
    if [ -z "$(api GET "/volumes/$vid" 2>/dev/null | jq -r '.volume.server // empty')" ]; then
      detached=1; break
    fi
    sleep 2
  done
  [ "$detached" = 1 ] || info "volume still attached after 60s; deleting anyway"
  api DELETE "/volumes/$vid" >/dev/null || failed=1

  # Confirm they are actually gone rather than trusting the delete calls. A 404
  # here is the success case.
  local server_gone=0 volume_gone=0
  api GET "/servers/$sid" >/dev/null 2>&1 || server_gone=1
  api GET "/volumes/$vid" >/dev/null 2>&1 || volume_gone=1

  if [ "$server_gone" = 1 ]; then info "server deleted"; else info "SERVER STILL EXISTS (id $sid)"; failed=1; fi
  if [ "$volume_gone" = 1 ]; then info "volume deleted"; else info "VOLUME STILL EXISTS (id $vid)"; failed=1; fi

  if [ "$failed" = 1 ]; then
    # Keep local state. Deleting it would orphan paid resources with no record of
    # what to clean up — the worst possible outcome of a teardown command.
    echo
    echo "Teardown did NOT fully succeed. $STATE_FILE has been kept so you can retry." >&2
    echo "Check https://console.hetzner.cloud/ and confirm nothing is still billing." >&2
    exit 1
  fi

  rm -f "$STATE_FILE"
  info "done. The SSH key and firewall remain (both free); delete them in the"
  info "console if you want the project completely clean."
  info "The API token is no longer needed — delete it too."
}

case "${1:-}" in
  provision) shift; cmd_provision "$@" ;;
  node)
    shift
    case "${1:-}" in
      up)     shift; cmd_node_up "$@" ;;
      status) shift; cmd_node_status "$@" ;;
      ready)  shift; cmd_node_ready "$@" ;;
      logs)   shift; cmd_node_logs "$@" ;;
      *) die "usage: ./snapstart node {up|status|ready|logs}" ;;
    esac ;;
  volume)
    shift
    case "${1:-}" in
      grow) shift; cmd_volume_grow "$@" ;;
      *) die "usage: ./snapstart volume grow <GB>" ;;
    esac ;;
  status)    shift; cmd_status "$@" ;;
  tunnel)    shift; cmd_tunnel "$@" ;;
  client)
    shift
    case "${1:-}" in
      create) shift; cmd_client_create "$@" ;;
      ui)     shift; cmd_client_ui "$@" ;;
      *) die "usage: ./snapstart client {create|ui}" ;;
    esac ;;
  ssh)       shift; cmd_ssh "$@" ;;
  destroy)   shift; cmd_destroy "$@" ;;
  *) sed -n '3,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
esac
